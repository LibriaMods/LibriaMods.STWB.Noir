<Project Sdk="Microsoft.NET.Sdk">
  <!-- Syberia Noir: a LibriaMods mod (ILibriaMod), loaded and hot-reloaded by LibriaMods.Unity.Loader.
       Needs the LibriaMods.Unity.Shared repo cloned next to this one. -->
  <PropertyGroup>
    <Version>1.1.1</Version>
    <!-- Where Syberia: The World Before is installed. Override SyberiaTWBDir in ..\LibriaMods.user.props. -->
    <SyberiaTWBDir Condition="'$(SyberiaTWBDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Syberia - The World Before</SyberiaTWBDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\LibriaMods.Unity.Shared\LibriaMods.Unity.Shared\LibriaMods.Unity.Shared.csproj" Private="false" />
    <!-- Built alongside, so the loader can be installed with the mod. -->
    <ProjectReference Include="..\..\LibriaMods.Unity.Shared\LibriaMods.Unity.Loader\LibriaMods.Unity.Loader.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- If the game is installed: mod → UserData\LibriaMods\Mods (hot-reloaded); loader → Mods and shared lib → UserLibs only if missing. -->
  <Target Name="InstallToGame" AfterTargets="Build" Condition="Exists('$(SyberiaTWBDir)\SyberiaTWB.exe')">
    <MSBuild Projects="..\..\LibriaMods.Unity.Shared\LibriaMods.Unity.Loader\LibriaMods.Unity.Loader.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="LoaderDll" />
    </MSBuild>
    <ItemGroup>
      <SharedLib Include="@(ReferencePath)" Condition="'%(Filename)' == 'LibriaMods.Unity.Shared'" />
    </ItemGroup>
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb" DestinationFolder="$(SyberiaTWBDir)\UserData\LibriaMods\Mods" />
    <!-- Loader and shared lib are copied only if missing: the game loads them once at startup, so replacing them
         would need a restart. After changing LibriaMods.Unity.Shared, copy them yourself (and restart the game). -->
    <Copy SourceFiles="@(LoaderDll)" DestinationFolder="$(SyberiaTWBDir)\Mods" Condition="!Exists('$(SyberiaTWBDir)\Mods\%(LoaderDll.Filename)%(LoaderDll.Extension)')" />
    <Copy SourceFiles="@(SharedLib)" DestinationFolder="$(SyberiaTWBDir)\UserLibs" Condition="!Exists('$(SyberiaTWBDir)\UserLibs\%(SharedLib.Filename)%(SharedLib.Extension)')" />
  </Target>
</Project>
